within MSLFaults.UsersGuide;
class Overview "Scope and package organisation"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>MSLFaults provides deterministic component fault models associated with Modelica Standard Library 4.0.0 counterparts. The domains cover signal processing, analogue electrical circuits, rotational and translational mechanics, heat transfer, fluid networks and magnetic circuits.</p><p>Select a component by its interface and nominal relation, compare its Normal mode in the intended system, then configure one fault mechanism. The Examples package supplies complete comparison models; Utilities contains their internal assemblies.</p></html>"));
end Overview;
